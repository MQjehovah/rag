{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "default-blueprint/v1",
  "title": "default-blueprint/v1",
  "type": "object",
  "description": "default Skill 蓝图结构占位（Phase 6 蓝图由 Phase 5 synthesis 决定，此处仅声明式资源）。",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "default-blueprint/v1"
    },
    "versioned": {
      "type": "boolean"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "section_type": {
            "type": "string"
          },
          "version_label": {
            "type": ["string", "null"]
          }
        }
      }
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
