# 请将本文件复制为 .env，然后在 .env 中填写真实配置。
# 禁止提交 .env；本示例文件中不得包含真实密码或 API 密钥。

# 大语言模型 / Ollama
# Docker部署且模型运行在宿主机时，改为http://host.docker.internal:11434。
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# 向量模型：本地 Ollama bge-m3
# Docker部署且Embedding运行在宿主机时，改为http://host.docker.internal:11434/api/embed。
EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# 可选：重排模型
RERANKER_API_URL=
RERANKER_MODEL=

# 文档分块与检索
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
VECTOR_RECALL_K=50

# PDF 图片文字识别（OCR）
# 启用后会增加同步耗时，但能补充截图和扫描页中的可识别文字。
PDF_OCR_ENABLED=true
# 渲染清晰度；200 对小号界面文字更友好，同时保持可控的内存占用。
PDF_OCR_DPI=200
# 只保留高于该置信度的 OCR 结果，降低错字和噪声。
PDF_OCR_MIN_CONFIDENCE=0.86
# 与 PDF 文本层相似度达到该值时视为重复，不再次写入 Markdown。
PDF_OCR_DUPLICATE_SIMILARITY=0.86
# 过短内容通常是页码或图标标记，默认不写入知识库。
PDF_OCR_MIN_NOVEL_CHARS=4
# 单份 PDF 最多处理的页数，防止超大文件长时间占用服务。
PDF_OCR_MAX_PAGES=80

# PDF 重要图片保存与视觉理解
# 保存被判定为重要的页面图，Markdown 中会保留可查看的原图链接。
PDF_IMAGE_ASSETS_ENABLED=true
PDF_IMAGE_STORAGE_DIR=./data/pdf-pages
PDF_IMAGE_DPI=144
PDF_IMAGE_MAX_WIDTH=1800
PDF_IMAGE_MAX_PAGES=60
PDF_IMAGE_IMPORTANCE_THRESHOLD=4.0
# 视觉模型用于理解箭头、标号、按钮位置、区域关系和截图操作顺序。
PDF_VISION_ENABLED=true
PDF_VISION_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 留空时复用 LLM_API_KEY，避免在配置中重复保存密钥。
PDF_VISION_API_KEY=
PDF_VISION_MODEL=glm-4v-flash
# P17：disabled / local / remote。留空时按 PDF_VISION_ENABLED 推断。
VISION_MODE=
# remote 模式必须显式允许，否则降级为 local，敏感图也不会发到外部服务。
VISION_REMOTE_ALLOWED=false
# 视觉分析页数按 PDF 总页数动态计算；1.0 表示分析全部重要图片候选页。
PDF_VISION_PAGE_RATIO=1.0
# 小型 PDF 的最低分析额度；实际不会超过 PDF 总页数和重要图片候选数。
PDF_VISION_MIN_PAGES=10
# 超大 PDF 的视觉分析安全上限，0 表示不设置安全上限。
PDF_VISION_HARD_MAX_PAGES=60
PDF_VISION_CONCURRENCY=2
PDF_VISION_TIMEOUT_SECONDS=120

# 后端服务
HOST=127.0.0.1
PORT=8000

# 本地开发数据库；生产环境建议使用 PostgreSQL + pgvector。
DATABASE_URL=sqlite:///./data/notes.db
# 仅在使用“docker compose --profile pg”启动内置PostgreSQL时填写。
POSTGRES_DB=notesrag
POSTGRES_USER=postgres
# 生产环境必须设置强密码，并与DATABASE_URL中的密码保持一致。
POSTGRES_PASSWORD=

# 可选：MinIO 对象存储
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# 可选：LDAP
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_FILTER=(member={user_dn})
# 管理员组映射：用户属于这些组即视为 admin。填写 LDAP 返回的组名（cn 值），
# 支持逗号分隔多个组，例如 "admins,kb-admins"
LDAP_GROUP_MAP_ADMIN=
# wiki_editor 角色映射：用户属于这些组即获得 Wiki 编辑权（admin 天然拥有）。
# 填写 LDAP 返回的组名（cn 值），支持逗号分隔多个组，例如 "editors,kb-editors"
LDAP_GROUP_MAP_WIKI_EDITOR=

# 身份认证
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=

# 钉钉知识库
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_KNOWLEDGE_BASE_ID=
DINGTALK_OPERATOR_ID=

# 可选：自动整理知识图谱
AUTO_ORGANIZE_ENABLED=false
AUTO_ORGANIZE_INTERVAL_HOURS=24

# 钉钉文档同步范围：configured 表示只同步上方指定的知识库；all_authorized 表示同步全部有权限的知识库。
DINGTALK_SYNC_SCOPE=configured
# 第一阶段支持的文件格式，使用英文逗号分隔。
DINGTALK_SUPPORTED_EXTENSIONS=pdf,docx,pptx,xlsx,txt,csv,md
# 是否同步钉钉Wiki页面以及递归读取子目录。
DINGTALK_INCLUDE_WIKI=true
DINGTALK_INCLUDE_SUBFOLDERS=true
# 钉钉原文件、Markdown、资源文件和同步清单的本地保存根目录。
DINGTALK_LOCAL_STORAGE_DIR=./data/dingtalk
# 同时下载的文件数量；建议保持在2到4之间，避免触发钉钉接口限流。
DINGTALK_DOWNLOAD_CONCURRENCY=3
# 批量PDF转Markdown继续启用现有OCR、重要图片保存和视觉说明能力。
DINGTALK_MARKDOWN_PDF_ENHANCED=true

# Markdown转换器
# Word、Excel、PPT优先使用MarkItDown；失败时自动回退到项目原有解析器。
MARKITDOWN_ENABLED=true
# PDF使用MarkItDown逐页正文，并融合原有表格、OCR、重要图片和视觉说明。
PDF_HYBRID_ENABLED=true
# 混合解析整体失败时，是否允许使用整份MarkItDown结果作为最后兜底。
MARKITDOWN_PDF_FALLBACK_ENABLED=true

# 老师服务器上的现有RAG知识库，通过后端接口执行远程导入。
# 目标知识库名称固定为“钉钉知识库”；建议实际运行时再填写账号密码。
REMOTE_RAG_BASE_URL=http://192.168.31.34:8092
REMOTE_RAG_USERNAME=
REMOTE_RAG_PASSWORD=
REMOTE_RAG_NOTEBOOK_NAME=钉钉知识库
# 通常留空，由程序按名称精确查找；确认后也可以填写知识库ID进一步防止写错。
REMOTE_RAG_NOTEBOOK_ID=
REMOTE_RAG_TIMEOUT_SECONDS=300
REMOTE_RAG_MAX_RETRIES=3
REMOTE_RAG_STATE_FILE=./data/dingtalk/remote-sync-state.json
REMOTE_RAG_BACKUP_DIR=./data/dingtalk/remote-backups
CARD_V3_ENABLED=true
UNIFIED_RETRIEVAL_ENABLED=true
DEBT_CHAT_ENABLED=true
CARD_GRAPH_ENABLED=false
WIKI_TOPIC_ENABLED=false
# P19：louvain（默认）或 connected_components
COMMUNITY_ALGORITHM=louvain
COMMUNITY_REBUILD_ASYNC=true

# 单篇普通文档期望生成的 Card 软上限
CARD_MAX_PER_DOCUMENT=5
# 大型综合手册（LLM 任务级分组后）的目标 Card 上限
CARD_MAX_PER_LARGE_DOCUMENT=10
# Card 聚合策略：rule|llm|auto|compare。auto=规则达标即用，超限调 LLM 分组
CARD_CONSOLIDATION_STRATEGY=auto
# 本地关键词合并阈值；值越低越容易合并
CARD_CLUSTER_SIMILARITY_THRESHOLD=0.25
# Embedding 可用时参与主题合并，不可用时自动降级
CARD_CLUSTER_EMBEDDING_ENABLED=true

# 图谱视图最大节点数；超出截断并在 API 标记 truncated
GRAPH_VIEW_MAX_NODES=300
# 图谱关系最小置信度
GRAPH_MIN_RELATION_CONFIDENCE=0.5

# P14 灰度与回滚。上线前保持数据源总入口和新 Connector 关闭；
# 最终切换必须通过 /api/p14/status 的门禁，禁止只改环境变量跳过验收。
SOURCE_HUB_ENABLED=false
DINGTALK_CONNECTOR_ENABLED=false
GITLAB_CONNECTOR_ENABLED=false
SOURCE_CARD_COMPILE_ENABLED=false
LEGACY_SEARCH_VISIBLE=true
