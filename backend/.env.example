# 请将本文件复制为 .env，然后在 .env 中填写真实配置。
# 禁止提交 .env；本示例文件中不得包含真实密码或 API 密钥。

# 大语言模型 / Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# 向量模型：本地 Ollama bge-m3
EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# 可选：重排模型
RERANKER_API_URL=
RERANKER_MODEL=

# 文档分块与检索
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
VECTOR_RECALL_K=50

# 后端服务
HOST=127.0.0.1
PORT=8000

# 本地开发数据库；生产环境建议使用 PostgreSQL + pgvector。
DATABASE_URL=sqlite:///./data/notes.db

# 可选：MinIO 对象存储
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# 可选：LDAP
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_GROUP_MAP_ADMIN=

# 身份认证
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=

# 钉钉知识库
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_KNOWLEDGE_BASE_ID=
DINGTALK_OPERATOR_ID=

# 可选：自动整理知识图谱
AUTO_ORGANIZE_ENABLED=false
AUTO_ORGANIZE_INTERVAL_HOURS=24
