# Ollama配置
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding配置 (OpenAI兼容API)
EMBEDDING_API_URL=http://192.168.31.34:8000/v1/embeddings
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# Reranker配置 (独立部署)
RERANKER_API_URL=http://192.168.31.34:8001/v1/rerank
RERANKER_MODEL=bge-reranker-v2-m3

# 文档配置
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 检索配置
TOP_K=5
VECTOR_RECALL_K=50

# 服务配置
HOST=0.0.0.0
PORT=8000

# PostgreSQL数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/notesrag

# MinIO配置
MINIO_ENDPOINT=192.168.31.8:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=xzyz2022!
MINIO_BUCKET=xzrobotserver
MINIO_SECURE=false

# LDAP配置
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_GROUP_MAP_ADMIN=

# JWT配置
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# 本地管理员
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
