# 运行环境:development(默认)/production/prod;生产下弱值或缺失必填秘密将拒绝启动
APP_ENV=development

# Ollama配置
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding配置 (OpenAI兼容API)
EMBEDDING_API_URL=http://192.168.31.34:8000/v1/embeddings
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# Reranker配置 (独立部署)
RERANKER_API_URL=http://192.168.31.34:8001/v1/rerank
RERANKER_MODEL=bge-reranker-v2-m3

# 文档配置
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 检索配置
TOP_K=5
VECTOR_RECALL_K=50

# 服务配置
HOST=0.0.0.0
PORT=8000

# CORS 白名单(逗号分隔);前端 dev 端口为 3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/notesrag

# MinIO配置
MINIO_ENDPOINT=192.168.31.8:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=xzrobotserver
MINIO_SECURE=false

# LDAP配置
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_GROUP_MAP_ADMIN=

# JWT配置
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=720

# 本地管理员
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=change-me

# 图片签名 URL 的 HMAC 密钥;留空则回退 JWT_SECRET_KEY
IMAGE_SIGN_SECRET=change-me
# 图片签名有效期(秒)
IMAGE_SIGN_TTL_SECONDS=3600

# 多模态(图片 OCR/描述),默认关闭
MULTIMODAL_ENABLED=false

# SSO/OIDC:资源端 token 校验(issuer/audience/jwks);client_* 供前端/其他组件使用
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URI=
SSO_CLIENT_ID=change-me
SSO_CLIENT_SECRET=change-me
SSO_REDIRECT_URI=http://localhost:3000/sso/callback

# LLM(chat/JSON):给 LLM_BASE_URL 会自动补 /chat/completions,或直接给 LLM_API_URL
LLM_BASE_URL=
LLM_MODEL=
LLM_API_URL=
